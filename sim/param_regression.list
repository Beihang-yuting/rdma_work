# 参数化回归：suite test tags plusargs；旧 filelist 不变。
env rdma_env_basic_test baseline
env rdma_env_random_test baseline
env rdma_env_reliability_test baseline
env rdma_scenario_cfg_test candidate
env rdma_scenario_cfg_test candidate,cli +rdma.qp.depth=64 +EXPECT_DEPTH=64
env rdma_scenario_cfg_test candidate,leaf +depth=128 +EXPECT_DEPTH=128
env rdma_scenario_traffic_test single +rdma.traffic.count=8 +rdma.traffic.len=64 +EXPECT_DRAWS=16
env rdma_scenario_traffic_test mix +rdma.traffic.op=mix +rdma.traffic.count=32 +rdma.traffic.len=64
env rdma_scenario_traffic_test atomic +rdma.traffic.op=cas +rdma.traffic.count=8 +EXPECT_DRAWS=0
env rdma_scenario_traffic_test qp +rdma.traffic.op=write +rdma.qp.mtu=4096 +rdma.qp.psn=0xfffff0 +rdma.traffic.len={[1:256]:/30,[257:4096]:/70} +rdma.traffic.signaled_pct=50 +rdma.traffic.count=64
env rdma_scenario_traffic_test mem +rdma.traffic.op=read +rdma.mem.buf_bytes=0x40000 +rdma.mem.slot_bytes=0x2000 +rdma.mem.mr_offset=0x1000 +rdma.traffic.len=[4:8192] +rdma.traffic.sge=[1,2,4]
env rdma_scenario_traffic_test pkt +rdma.qp.type=UD +rdma.traffic.op=send +rdma.qp.mtu=512 +rdma.traffic.len=[1:512] +rdma.pkt.vlan_en=1 +rdma.pkt.vlan_id=7 +rdma.pkt.src_ip=10.1.0.1 +rdma.pkt.dst_ip=10.1.0.2 +rdma.pkt.udp_sport=50000
env rdma_scenario_traffic_test urc +rdma.qp.type=URC +rdma.traffic.op=write +rdma.qp.depth=64 +rdma.qp.timeout=10 +rdma.traffic.count=48
env rdma_scenario_multifunc_test multifunc +rdma.traffic.op=write +rdma.traffic.count=8 +rdma.traffic.len=64 +rdma.traffic.signaled_pct=100
env rdma_scenario_same_host_pf_test same_host_pf +rdma.traffic.op=write +rdma.traffic.count=8 +rdma.traffic.len=64 +rdma.traffic.signaled_pct=100
