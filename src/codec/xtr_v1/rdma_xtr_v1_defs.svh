// xtr_v1 hardware definition baseline, pinned by tools/check_xtr_v1_defs.py.
// OFFSET is a pre-serialization logical qword bit coordinate:
//   WORD_BYTE_OFFSET * 8 + LSB.
// It is not a raw bit index in the big-endian byte image. Codecs must build
// each logical u64 with LSB/WIDTH, then serialize that qword big-endian.
`define XTR_V1_FIELD(STEM, WORD_BYTE, FIELD_LSB, FIELD_WIDTH) \
  localparam int unsigned STEM``_WORD_BYTE_OFFSET = WORD_BYTE; \
  localparam int unsigned STEM``_LSB = FIELD_LSB; \
  localparam int unsigned STEM``_WIDTH = FIELD_WIDTH; \
  localparam int unsigned STEM``_OFFSET = ((WORD_BYTE) * 8) + (FIELD_LSB);

localparam int unsigned XTR_V1_QPC_BYTES = 512;
localparam int unsigned XTR_V1_CQC_BYTES = 64;
localparam int unsigned XTR_V1_CMQE_BYTES = 64;
localparam int unsigned XTR_V1_WQE_BYTES = 64;
localparam int unsigned XTR_V1_RQE_BYTES = 64;
localparam int unsigned XTR_V1_CQE_BYTES = 64;
localparam int unsigned XTR_V1_CEQE_BYTES = 16;
localparam int unsigned XTR_V1_AEQE_BYTES = 16;
localparam int unsigned XTR_V1_DB_BYTES = 8;

localparam bit [63:0] XTR_V1_NOTIFY_WINDOW_OFFSET = 64'h2000;
localparam bit [63:0] XTR_V1_NOTIFY_WINDOW_SIZE = 64'h2000;
localparam bit [63:0] XTR_V1_DB_CMQ_OFFSET = 64'h000;
localparam bit [63:0] XTR_V1_DB_SQ_OFFSET = 64'h100;
localparam bit [63:0] XTR_V1_DB_RQ_OFFSET = 64'h010;
localparam bit [63:0] XTR_V1_DB_CQ_OFFSET = 64'h018;
localparam bit [63:0] XTR_V1_DB_CEQ_OFFSET = 64'h020;
localparam bit [63:0] XTR_V1_DB_AEQ_OFFSET = 64'h028;
localparam bit [63:0] XTR_V1_DB_SRFQ_OFFSET = 64'h040;
localparam bit [63:0] XTR_V1_DB_RTS2SQD_OFFSET = 64'h048;
localparam bit [63:0] XTR_V1_DB_SQD2RTS_OFFSET = 64'h050;
localparam bit [63:0] XTR_V1_DB_QP_FLUSH_OFFSET = 64'h058;
localparam bit [63:0] XTR_V1_DB_TX_FLUSH_OFFSET = 64'h008;

localparam bit [7:0] XTR_V1_OP_QPC_CREATE = 8'h00;
localparam bit [7:0] XTR_V1_OP_QPC_MODIFY = 8'h01;
localparam bit [7:0] XTR_V1_OP_QPC_DELETE = 8'h02;
localparam bit [7:0] XTR_V1_OP_QPC_QUERY = 8'h03;
localparam bit [7:0] XTR_V1_OP_MR_REGISTER = 8'h05;
localparam bit [7:0] XTR_V1_OP_MR_DEREGISTER = 8'h06;
localparam bit [7:0] XTR_V1_OP_CQC_RESIZE = 8'h0b;
localparam bit [7:0] XTR_V1_OP_CQC_CREATE = 8'h0c;
localparam bit [7:0] XTR_V1_OP_CQC_MODIFY = 8'h0d;
localparam bit [7:0] XTR_V1_OP_CQC_DELETE = 8'h0e;
localparam bit [7:0] XTR_V1_OP_CQC_QUERY = 8'h0f;
localparam bit [7:0] XTR_V1_OP_CEQC_CREATE = 8'h10;
localparam bit [7:0] XTR_V1_OP_AEQC_CREATE = 8'h14;
localparam bit [7:0] XTR_V1_OP_QP_FLUSH = 8'h1a;
localparam bit [7:0] XTR_V1_OP_SRFQC_CREATE = 8'h35;
localparam bit [7:0] XTR_V1_OP_SRFQC_DELETE = 8'h37;
localparam bit [7:0] XTR_V1_OP_SRFQC_QUERY = 8'h38;
localparam bit [7:0] XTR_V1_OP_NOP = 8'h45;

localparam bit [7:0] XTR_V1_EC_TPE_DB_TYPE_INVLD = 8'h02;
localparam bit [7:0] XTR_V1_EC_TPE_SQ_KEY_ERR = 8'h19;
localparam bit [7:0] XTR_V1_EC_TPE_SQ_WQE_OPCODE_INVLD = 8'h1b;
localparam bit [7:0] XTR_V1_EC_TME_PKT_KEY_ERR = 8'h4c;
localparam bit [7:0] XTR_V1_EC_TDE_DMA_ERR = 8'h70;
localparam bit [7:0] XTR_V1_EC_RPE_SRFQ_LIMIT = 8'h78;
localparam bit [7:0] XTR_V1_EC_RPE_ICRC = 8'h7f;
localparam bit [7:0] XTR_V1_EC_RPE_RX_FLUSH = 8'h8f;
localparam bit [7:0] XTR_V1_EC_RCE_OCC_CQC = 8'hf2;
localparam bit [7:0] XTR_V1_EC_RCE_CQ_FULL = 8'hf4;
localparam bit [7:0] XTR_V1_EC_GLB_MBUS = 8'hff;

