set -euo pipefail; \
mkdir -p build/core; \
vcs -full64 -sverilog -ntb_opts uvm-1.2 -timescale=1ns/1ps -debug_access+class -f filelists/core.f -top tb_top -o build/core/simv; \
if [[ "rdma_cmq_codec_test" == regression ]]; then \
	mapfile -t suite_tests < <(sed -n '/^readonly CORE_TESTS=(/,/^)/p' ../scripts/run_queue_lifecycle_regression53.sh | sed -n 's/^[[:space:]]*\([A-Za-z_][A-Za-z0-9_]*\)[[:space:]]*$/\1/p'); \
	if (( ${#suite_tests[@]} == 0 )); then echo "core regression manifest is empty" >&2; exit 2; fi; \
	for test_name in "${suite_tests[@]}"; do \
			"../scripts/run_core_logical_test.sh" "$test_name" "build/core" "rdma_cmq_engine_process.list" "../scripts/check_uvm_summary.sh"; \
	done; \
else \
		"../scripts/run_core_logical_test.sh" "rdma_cmq_codec_test" "build/core" "rdma_cmq_engine_process.list" "../scripts/check_uvm_summary.sh"; \
fi
